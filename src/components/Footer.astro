---
import Logo from "./Logo.astro";
import {
  MapPin,
  Phone,
  Mail,
  ArrowUpRight,
  ShieldCheck,
  Calendar,
  Heart
} from "lucide-react";
---

<footer class="bg-[#f8fafc] text-slate-600 border-t border-slate-200 pt-16 pb-12 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-200">
      
      {/* Col 1: Brand & Bio */}
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="inline-block">
          <Logo size={36} />
        </a>


        {/* Service Area & Contact info */}
        <div class="space-y-2 pt-2 text-xs text-slate-700">
          <div class="flex items-start gap-2">
            <MapPin class="w-4 h-4 text-[#059669] shrink-0 mt-0.5" />
            <span>Serving Businesses Across Faridabad & NCR (On-Site & Remote Consultations)</span>
          </div>
          <div class="flex items-center gap-2">
            <Phone class="w-4 h-4 text-[#059669] shrink-0" />
            <a href="https://wa.me/918287367640" target="_blank" rel="noopener noreferrer" class="hover:text-[#059669] transition-colors font-mono font-bold text-slate-800">WhatsApp: +91 8287367640</a>
          </div>
        </div>
      </div>

      {/* Col 2: Solutions */}
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider font-mono">
          AI Solutions
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/services/ai-automation-agency-faridabad" class="hover:text-[#059669] transition-colors">AI Automation Agency</a>
          </li>
          <li>
            <a href="/services/ai-voice-agent-faridabad" class="hover:text-[#059669] transition-colors">Bilingual AI Voice Agents</a>
          </li>
          <li>
            <a href="/services/website-development-faridabad" class="hover:text-[#059669] transition-colors">Website Development</a>
          </li>
          <li>
            <a href="/services/whatsapp-automation-faridabad" class="hover:text-[#059669] transition-colors">WhatsApp CRM Engine</a>
          </li>
          <li>
            <a href="/comparisons/ai-agency-vs-traditional-it-faridabad" class="hover:text-[#059669] transition-colors">AI Agency vs Traditional IT</a>
          </li>
          <li>
            <a href="/portfolio" class="text-[#059669] font-bold hover:underline">Our Website Portfolio →</a>
          </li>
          <li>
            <a href="/services" class="hover:text-[#059669] transition-colors">View All Services →</a>
          </li>
        </ul>
      </div>

      {/* Col 3: Faridabad Hub */}
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider font-mono">
          Faridabad & NCR Coverage
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/areas-we-serve/mathura-road-faridabad" class="hover:text-[#059669] transition-colors">Mathura Road Industrial Area</a>
          </li>
          <li>
            <a href="/areas-we-serve/dlf-industrial-area-faridabad" class="hover:text-[#059669] transition-colors">DLF Industrial Sector 24/25</a>
          </li>
          <li>
            <a href="/areas-we-serve/ballabgarh-faridabad" class="hover:text-[#059669] transition-colors">Ballabgarh Manufacturing Hub</a>
          </li>
          <li>
            <a href="/areas-we-serve/greater-faridabad-neharpar" class="hover:text-[#059669] transition-colors">Greater Faridabad (Neharpar)</a>
          </li>
          <li>
            <a href="/areas-we-serve/sector-15-16-faridabad" class="hover:text-[#059669] transition-colors">Sector 15 & 16 Corporate Hub</a>
          </li>
          <li>
            <a href="/areas-we-serve" class="text-[#059669] font-semibold hover:underline">All Faridabad Zones →</a>
          </li>
        </ul>
      </div>

      {/* Col 4: Quick Action */}
      <div class="space-y-3">
        <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider font-mono">
          Get Started
        </h4>
        <p class="text-xs text-slate-600">
          Ready to deploy practical AI automations or high-performance websites in Faridabad?
        </p>
        <a
          href="/#audit-section"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#00dc82] hover:bg-[#05df85] text-black font-bold text-xs shadow-md transition-all cursor-pointer"
        >
          <Calendar class="w-3.5 h-3.5" />
          <span>Book Free AI Audit</span>
        </a>
        <div class="pt-2 flex items-center gap-1.5 text-[11px] text-[#059669] font-semibold">
          <ShieldCheck class="w-3.5 h-3.5" />
          <span>Direct Local Support • Faridabad & NCR</span>
        </div>
      </div>

    </div>

    {/* Bottom Copyright & SEO Citation */}
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        © {new Date().getFullYear()} MooreRevenue
      </div>
      <div class="flex items-center gap-4 font-medium">
        <a href="/portfolio" class="hover:text-[#059669] transition-colors">Portfolio</a>
        <a href="/#audit-section" class="hover:text-[#059669] transition-colors">Privacy Policy</a>
        <a href="/#audit-section" class="hover:text-[#059669] transition-colors">Terms of Service</a>
        <a href="/#roi-calculator" class="hover:text-[#059669] transition-colors">ROI Blueprint</a>
      </div>
    </div>
  </div>
</footer>
