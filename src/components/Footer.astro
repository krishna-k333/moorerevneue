---
import Logo from "./Logo.astro";
import {
  MapPin,
  Phone,
  ShieldCheck,
  Calendar,
} from "lucide-react";
---

<footer class="bg-[#f8fafc] text-slate-600 border-t border-slate-200 pt-16 pb-12 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-200">
      
      {/* Col 1: Brand & Bio */}
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="inline-block">
          <Logo size={36} />
        </a>

        {/* Service Area & Contact info */}
        <div class="space-y-2 pt-2 text-xs text-slate-700">
          <div class="flex items-start gap-2">
            <MapPin class="w-4 h-4 text-[#047857] shrink-0 mt-0.5" />
            <div>
              <span>Serving Businesses Across Faridabad, NCR & Beyond (On-Site & Global Remote Deployments)</span>
              <a
                href="https://share.google/9eP7csF1sUEW5wZyT"
                target="_blank"
                rel="noopener noreferrer"
                class="block text-[11px] text-[#047857] font-semibold hover:underline mt-0.5"
              >
                View Google Business Profile &rarr;
              </a>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <Phone class="w-4 h-4 text-[#047857] shrink-0" />
            <a href="https://wa.me/918287367640" target="_blank" rel="noopener noreferrer" class="hover:text-[#047857] transition-colors font-mono font-bold text-slate-800">WhatsApp: +91 8287367640</a>
          </div>
        </div>

        {/* Social Media Links */}
        <div class="pt-2">
          <div class="text-[11px] font-bold text-slate-900 uppercase tracking-wider font-mono mb-2">
            Follow & Connect
          </div>
          <div class="flex flex-wrap items-center gap-2.5">
            <a
              href="https://share.google/9eP7csF1sUEW5wZyT"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white border border-slate-200/80 hover:border-blue-500/40 hover:bg-blue-50/50 text-slate-700 hover:text-blue-600 text-xs font-semibold shadow-xs transition-all duration-200 group"
              aria-label="MooreRevenue on Google Maps"
            >
              <svg class="w-4 h-4 text-[#ea4335] transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
              <span>Google Maps</span>
              <span class="text-[10px] text-slate-400 group-hover:text-blue-500 font-mono">Profile</span>
            </a>

            <a
              href="https://youtube.com/@preparemytech"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white border border-slate-200/80 hover:border-red-500/40 hover:bg-red-50/50 text-slate-700 hover:text-red-600 text-xs font-semibold shadow-xs transition-all duration-200 group"
              aria-label="YouTube Channel @preparemytech"
            >
              <svg class="w-4 h-4 text-[#ff0000] transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span>YouTube</span>
              <span class="text-[10px] text-slate-400 group-hover:text-red-500 font-mono">@preparemytech</span>
            </a>

            <a
              href="https://instagram.com/aiwkrishna"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white border border-slate-200/80 hover:border-pink-500/40 hover:bg-pink-50/50 text-slate-700 hover:text-pink-600 text-xs font-semibold shadow-xs transition-all duration-200 group"
              aria-label="Instagram Profile @aiwkrishna"
            >
              <svg class="w-4 h-4 text-[#e1306c] transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Instagram</span>
              <span class="text-[10px] text-slate-400 group-hover:text-pink-500 font-mono">@aiwkrishna</span>
            </a>
          </div>
        </div>
      </div>

      {/* Col 2: Solutions */}
      <div class="space-y-3">
        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider font-mono">
          AI Solutions
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/services/local-seo-aeo-faridabad" class="hover:text-[#047857] transition-colors font-medium text-slate-800">Local SEO & AI Visibility (AEO)</a>
          </li>
          <li>
            <a href="/services/ai-automation-agency-faridabad" class="hover:text-[#047857] transition-colors">AI Automation Agency</a>
          </li>
          <li>
            <a href="/services/ai-voice-agent-faridabad" class="hover:text-[#047857] transition-colors">Bilingual AI Voice Agents</a>
          </li>
          <li>
            <a href="/services/website-development-faridabad" class="hover:text-[#047857] transition-colors">Website Development</a>
          </li>
          <li>
            <a href="/services/whatsapp-automation-faridabad" class="hover:text-[#047857] transition-colors">WhatsApp CRM Engine</a>
          </li>
          <li>
            <a href="/comparisons/ai-agency-vs-traditional-it-faridabad" class="hover:text-[#047857] transition-colors">AI Agency vs Traditional IT</a>
          </li>
          <li>
            <a href="/portfolio" class="text-[#047857] font-bold hover:underline">Our Website Portfolio →</a>
          </li>
          <li>
            <a href="/services" class="hover:text-[#047857] transition-colors">View All Services →</a>
          </li>
        </ul>
      </div>

      {/* Col 3: Faridabad Hub */}
      <div class="space-y-3">
        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider font-mono">
          Faridabad & NCR Coverage
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/areas-we-serve/mathura-road-faridabad" class="hover:text-[#047857] transition-colors">Mathura Road Industrial Area</a>
          </li>
          <li>
            <a href="/areas-we-serve/dlf-industrial-area-faridabad" class="hover:text-[#047857] transition-colors">DLF Industrial Sector 24/25</a>
          </li>
          <li>
            <a href="/areas-we-serve/ballabgarh-faridabad" class="hover:text-[#047857] transition-colors">Ballabgarh Manufacturing Hub</a>
          </li>
          <li>
            <a href="/areas-we-serve/greater-faridabad" class="hover:text-[#047857] transition-colors">Greater Faridabad</a>
          </li>
          <li>
            <a href="/areas-we-serve/sector-15-16-faridabad" class="hover:text-[#047857] transition-colors">Sector 15 & 16 Corporate Hub</a>
          </li>
          <li>
            <a href="/areas-we-serve" class="text-[#047857] font-semibold hover:underline">All Faridabad Zones →</a>
          </li>
        </ul>
      </div>

      {/* Col 4: Quick Action */}
      <div class="space-y-3">
        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider font-mono">
          Get Started
        </h3>
        <p class="text-xs text-slate-600">
          Ready to deploy practical AI automations or high-performance websites in Faridabad?
        </p>
        <a
          href="/#audit-section"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#00dc82] hover:bg-[#05df85] text-black font-bold text-xs shadow-md transition-all cursor-pointer"
        >
          <Calendar class="w-3.5 h-3.5" />
          <span>Book Free AI Audit</span>
        </a>
        <div class="pt-2 flex items-center gap-1.5 text-[11px] text-[#047857] font-semibold">
          <ShieldCheck class="w-3.5 h-3.5" />
          <span>Direct Local Support • Faridabad & NCR</span>
        </div>
      </div>

    </div>

    {/* Bottom Copyright & SEO Citation */}
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        &copy; {new Date().getFullYear()} MooreRevenue
      </div>
      <div class="flex items-center gap-4 font-medium flex-wrap justify-center sm:justify-end">
        <a href="/portfolio" class="hover:text-[#047857] transition-colors">Portfolio</a>
        <a href="https://share.google/9eP7csF1sUEW5wZyT" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 transition-colors">Google Maps</a>
        <a href="https://youtube.com/@preparemytech" target="_blank" rel="noopener noreferrer" class="hover:text-red-600 transition-colors">YouTube</a>
        <a href="https://instagram.com/aiwkrishna" target="_blank" rel="noopener noreferrer" class="hover:text-pink-600 transition-colors">Instagram</a>
        <a href="/#audit-section" class="hover:text-[#047857] transition-colors">Privacy Policy</a>
        <a href="/#audit-section" class="hover:text-[#047857] transition-colors">Terms of Service</a>
        <a href="/#audit-section" class="hover:text-[#047857] transition-colors">Discovery Call</a>
      </div>
    </div>
  </div>
</footer>
