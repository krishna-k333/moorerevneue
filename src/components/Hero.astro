---
// Native Astro Hero Component - Zero JS hydration overhead, instant load speed
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-white">
  <!-- Background Glows & Grids -->
  <div class="absolute inset-0 bg-grid-pattern opacity-60 pointer-events-none"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-[#00dc82]/15 rounded-full blur-[140px] pointer-events-none animate-pulse-glow"></div>
  <div class="absolute top-1/3 left-10 w-[350px] h-[350px] bg-emerald-300/20 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-4xl mx-auto space-y-6">
      <!-- Top Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-50/80 text-[#047857] text-xs md:text-sm font-semibold backdrop-blur-md shadow-xs transition-transform hover:scale-105">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#047857] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#047857]"></span>
        </span>
        <span>AI Automation in Faridabad & NCR</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#047857]">
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </div>

      <!-- Primary SEO Heading (H1) with Exact Keyword Target -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 leading-[1.12]">
        AI Automation Agency in{" "}
        <span class="relative inline-block text-transparent bg-clip-text bg-gradient-to-r from-[#047857] via-[#059669] to-[#00dc82]">
          Faridabad
          <svg
            class="absolute -bottom-2 left-0 w-full h-2 text-[#059669]/40"
            viewBox="0 0 300 12"
            fill="none"
          >
            <path
              d="M1 9C50 3 150 1 299 9"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
            ></path>
          </svg>
        </span>
      </h1>

      <!-- Subheading / Value Proposition -->
      <p class="text-base sm:text-lg md:text-xl text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
        We build custom <strong class="text-slate-900 font-semibold">AI Voice Agents</strong>, WhatsApp automations, and fast modern websites for businesses across Faridabad & NCR.
      </p>

      <!-- Action CTAs -->
      <div class="pt-3 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#audit-section"
          class="w-full sm:w-auto px-8 py-4 text-base font-bold text-black bg-[#00dc82] hover:bg-[#05df85] rounded-xl shadow-[0_4px_20px_rgba(0,220,130,0.35)] hover:shadow-[0_6px_30px_rgba(0,220,130,0.55)] transition-all duration-300 flex items-center justify-center gap-2 group cursor-pointer active:scale-95 text-inherit no-underline"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-black">
            <path d="M8 2v3"></path>
            <path d="M16 2v3"></path>
            <rect width="18" height="18" x="3" y="4" rx="2"></rect>
            <path d="M3 10h18"></path>
          </svg>
          <span>Book a Free Discovery Call</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>

        <a
          href="https://wa.me/918287367640"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-6 py-4 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-800 font-semibold text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer shadow-xs text-inherit no-underline"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#059669]">
            <path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>WhatsApp +91 8287367640</span>
        </a>
      </div>
    </div>
  </div>
</section>
