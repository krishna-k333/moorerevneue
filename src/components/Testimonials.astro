---
import { Play, Star, Quote, Award } from "lucide-react";
---

<section id="testimonials" class="py-24 bg-slate-50/60 border-y border-slate-200/80 relative overflow-hidden">
  {/* Soft Background Accent */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-emerald-400/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-emerald-500/30 bg-emerald-50 text-[#059669] text-xs font-semibold uppercase tracking-wider shadow-xs">
        <Award class="w-3.5 h-3.5" />
        Client Testimonials & Case Studies
      </div>

      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        See Real Impact Delivered Through <span class="text-[#059669]">AI Automation</span>
      </h2>

    </div>

    {/* Featured Video Testimonial Card */}
    <div class="max-w-4xl mx-auto">
      <div class="bg-white rounded-3xl p-4 sm:p-6 md:p-8 border border-slate-200 shadow-xl space-y-6">
        
        {/* Responsive Video Container */}
        <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-md border border-slate-200/80 bg-slate-900">
          <iframe
            class="w-full h-full absolute inset-0"
            src="https://www.youtube-nocookie.com/embed/NmS6j-tzLd8?rel=0"
            title="Client Testimonial Video - MooreRevenue AI Automation"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        {/* Video Details & Rating */}
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
          <div class="space-y-1">
            <div class="flex items-center gap-1 text-amber-400">
              <Star class="w-4 h-4 fill-amber-400" />
              <Star class="w-4 h-4 fill-amber-400" />
              <Star class="w-4 h-4 fill-amber-400" />
              <Star class="w-4 h-4 fill-amber-400" />
              <Star class="w-4 h-4 fill-amber-400" />
              <span class="text-xs font-mono font-bold text-slate-700 ml-1.5">5.0 Star Verified Review</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900">
              Client Case Study
            </h3>
          </div>

          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-50 border border-emerald-200 text-[#059669] text-xs font-mono font-bold shrink-0">
            <Quote class="w-3.5 h-3.5" />
            <span>Verified Client Experience</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
