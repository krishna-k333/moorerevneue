---
interface Metric {
  value: string;
  label: string;
  sub: string;
}

const metrics: Metric[] = [
  {
    value: "₹4.8 Cr+",
    label: "Client Revenue Generated",
    sub: "Across Faridabad & NCR clients",
  },
  {
    value: "180,000+",
    label: "Manual Hours Automated",
    sub: "Saved from repetitive workflows",
  },
  {
    value: "99.4%",
    label: "Task Execution Precision",
    sub: "Enterprise-grade reliability",
  },
  {
    value: "14 Days",
    label: "Rapid Deployment Time",
    sub: "From discovery audit to live AI",
  },
];

const integrations = [
  "WhatsApp Cloud API",
  "Vapi & ElevenLabs Voice AI",
  "Astro & React Web",
  "OpenAI & DeepSeek",
  "Anthropic Claude",
  "Zoho CRM",
  "HubSpot CRM",
  "Salesforce",
  "Make.com & Zapier",
  "Google Workspace",
  "PostgreSQL / Supabase",
];
---

<section class="py-12 border-y border-slate-200 bg-slate-50/70 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Numbers Grid */}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 mb-12">
      {metrics.map((m) => (
        <div class="text-center p-5 rounded-2xl bg-white border border-slate-200 shadow-xs transition-transform hover:-translate-y-1">
          <div class="text-3xl sm:text-4xl font-extrabold text-[#059669] tracking-tight">
            {m.value}
          </div>
          <div class="text-sm font-bold text-slate-900 mt-1">
            {m.label}
          </div>
          <div class="text-xs text-slate-500 mt-0.5 font-medium">
            {m.sub}
          </div>
        </div>
      ))}
    </div>

    {/* Integrations Ticker Bar */}
    <div class="space-y-4 text-center">
      <p class="text-xs uppercase tracking-widest text-slate-500 font-semibold">
        Seamlessly Integrates With Your Existing Tech & ERP Stack
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 max-w-4xl mx-auto">
        {integrations.map((item) => (
          <span class="inline-flex items-center px-3.5 py-1.5 rounded-lg text-xs font-mono text-slate-700 bg-white border border-slate-200 hover:border-emerald-300 transition-colors shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-[#059669] mr-2"></span>
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
