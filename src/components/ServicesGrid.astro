---
import {
  PhoneCall,
  MessageSquare,
  Globe,
  Workflow,
  Check,
  ArrowRight,
  Layers
} from "lucide-react";

const services = [
  {
    title: "Bilingual AI Voice Calling Agents",
    badge: "Hindi & English",
    icon: PhoneCall,
    description: "Voice agents can answer common inquiries in Hindi and English and support meeting booking when configured with the required calendar integration.",
    highlights: [
      "Natural Hindi & English voice conversation",
      "Can be configured for concurrent calls",
      "Direct Google Calendar & CRM integration"
    ],
    link: "/services/ai-voice-agent-faridabad",
    linkText: "Learn about Voice Agents"
  },
  {
    title: "WhatsApp Business Automation",
    badge: "Official Meta Cloud API",
    icon: MessageSquare,
    description: "Automate selected WhatsApp workflows such as answering inquiries, sharing product information, and sending follow-up messages.",
    highlights: [
      "Automated replies for configured workflows",
      "Can use the official Meta Cloud API",
      "Follow-up reminders & appointment notifications"
    ],
    link: "/services/whatsapp-automation-faridabad",
    linkText: "Learn about WhatsApp Automation"
  },
  {
    title: "Website Development",
    badge: "Modern & Mobile-First",
    icon: Globe,
    description: "Websites and landing pages with responsive layouts, clear content, contact paths, and search-friendly structure.",
    highlights: [
      "Fast page load speeds on mobile & desktop",
      "Direct WhatsApp click-to-chat integration",
      "Search-friendly page structure"
    ],
    link: "/services/website-development-faridabad",
    linkText: "Learn about Web Development"
  },
  {
    title: "Business Workflow Automation",
    badge: "Custom Workflows",
    icon: Workflow,
    description: "Connect your day-to-day tools to eliminate repetitive manual work. Automatically route new leads, send team alerts, update spreadsheets, and keep your business running smoothly.",
    highlights: [
      "Connects forms, WhatsApp, and CRM databases",
      "Automated lead routing",
      "Simple setup with transparent 7–14 day delivery"
    ],
    link: "/services/ai-automation-agency-faridabad",
    linkText: "Learn about Workflow Automation"
  }
];
---

<section id="capabilities" class="py-20 bg-slate-50/70 border-y border-slate-200/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-emerald-500/30 bg-emerald-50 text-[#047857] text-xs font-semibold uppercase tracking-wider shadow-xs">
        <Layers class="w-3.5 h-3.5" />
        Our Core Services
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
        Simple, Practical Solutions for <span class="text-[#047857]">Local Businesses</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto">
        We build systems that help businesses save hours of manual work and respond to customers faster and grow your Revenue
      </p>
    </div>

    {/* Simple 2x2 Services Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {services.map((svc) => {
        const Icon = svc.icon;
        return (
          <a
            href={svc.link}
            class="group p-7 sm:p-8 rounded-2xl bg-white border border-slate-200 hover:border-emerald-400 hover:shadow-lg transition-all duration-300 flex flex-col justify-between block cursor-pointer text-inherit no-underline"
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-center text-[#047857] group-hover:scale-105 transition-transform duration-300">
                  <Icon class="w-6 h-6" />
                </div>
                <span class="text-xs font-mono font-semibold text-[#047857] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200/70">
                  {svc.badge}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-[#047857] transition-colors">
                {svc.title}
              </h3>

              <p class="text-sm text-slate-600 leading-relaxed">
                {svc.description}
              </p>

              {/* Simple Feature Checklist */}
              <ul class="space-y-2 pt-2 border-t border-slate-100">
                {svc.highlights.map((h) => (
                  <li class="flex items-center gap-2.5 text-xs sm:text-sm text-slate-700">
                    <div class="w-4 h-4 rounded-full bg-emerald-100 text-[#047857] flex items-center justify-center shrink-0">
                      <Check class="w-2.5 h-2.5 stroke-[3]" />
                    </div>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-6 mt-6 border-t border-slate-100">
              <div
                class="inline-flex items-center gap-2 text-sm font-semibold text-[#047857] group-hover:text-emerald-800 transition-colors"
              >
                <span>{svc.linkText}</span>
                <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
              </div>
            </div>
          </a>
        );
      })}
    </div>

  </div>
</section>
