---
import {
  PhoneCall,
  MessageSquare,
  Globe,
  Cpu,
  ShieldCheck,
  Zap,
  ArrowUpRight,
  Workflow,
  Layers,
  Bot
} from "lucide-react";
---

<section id="capabilities" class="py-24 relative overflow-hidden bg-slate-50/60 border-y border-slate-200/80">
  {/* Background accents */}
  <div class="absolute top-1/2 right-0 w-[500px] h-[500px] bg-[#00dc82]/10 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    {/* Section Heading */}
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-50 text-[#059669] text-xs font-semibold tracking-wide uppercase shadow-xs">
        <Layers class="w-3.5 h-3.5" />
        Core Services & AI Systems
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
        Built to Help Faridabad Businesses Grow
      </h2>
      <p class="text-base sm:text-lg text-slate-600">
        We replace repetitive manual tasks with practical AI voice agents, responsive WhatsApp pipelines, and modern websites that work 24/7.
      </p>
    </div>

    {/* Bento Grid Container */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      {/* Card 1: Bilingual AI Voice Calling Agent (7 Cols) */}
      <div class="lg:col-span-7 group rounded-3xl p-8 bg-white border border-slate-200/90 hover:border-emerald-400 hover:shadow-xl transition-all duration-300 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#059669]">
              <PhoneCall class="w-6 h-6" />
            </div>
            <span class="text-xs font-mono font-semibold text-[#059669] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
              Hindi & English Fluent
            </span>
          </div>

          <h3 class="text-2xl font-bold text-slate-900 mb-3">
            Bilingual AI Voice Calling Agents
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-6">
            Trained specifically for Indian business accents, nuances, and conversational context. Handles inbound inquiries, schedules meetings directly on your calendar, follows up on outstanding estimates, and qualifies cold leads with zero latency.
          </p>
        </div>

        {/* Mini Preview Widget */}
        <div class="space-y-2.5 p-4 rounded-xl bg-slate-50 border border-slate-200 font-mono text-xs">
          <div class="flex items-center justify-between text-slate-600">
            <span>Average Pickup Time:</span>
            <span class="text-[#059669] font-bold">Instant (0 - 1 Rings)</span>
          </div>
          <div class="flex items-center justify-between text-slate-600">
            <span>Call Handling:</span>
            <span class="text-[#059669] font-bold">Bulk Calls at Same Time</span>
          </div>
          <div class="flex items-center justify-between text-slate-600">
            <span>Direct Calendar Sync:</span>
            <span class="text-[#059669] font-bold">Google / Calendly / CRM</span>
          </div>
        </div>
      </div>

      {/* Card 2: WhatsApp Revenue & Sales Engine (5 Cols) */}
      <div class="lg:col-span-5 group rounded-3xl p-8 bg-white border border-slate-200/90 hover:border-emerald-400 hover:shadow-xl transition-all duration-300 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#059669]">
              <MessageSquare class="w-6 h-6" />
            </div>
            <span class="text-xs font-mono font-semibold text-[#059669] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
              Official Cloud API
            </span>
          </div>

          <h3 class="text-2xl font-bold text-slate-900 mb-3">
            WhatsApp Business Automation
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-6">
            Meet Faridabad & NCR customers on their primary messaging app. Instant quote delivery, automated catalogue sharing, payment link dispatches, and appointment re-engagement over official Meta APIs.
          </p>
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs font-mono">
            <span class="text-slate-600">Average Open Rate:</span>
            <span class="text-[#059669] font-bold">98%+</span>
          </div>
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs font-mono">
            <span class="text-slate-600">Automated Follow-ups:</span>
            <span class="text-[#059669] font-bold">Instant & Scheduled</span>
          </div>
        </div>
      </div>

      {/* Card 3: Conversion-Driven Web Engineering (5 Cols) */}
      <div class="lg:col-span-5 group rounded-3xl p-8 bg-white border border-slate-200/90 hover:border-emerald-400 hover:shadow-xl transition-all duration-300 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#059669]">
              <Globe class="w-6 h-6" />
            </div>
            <span class="text-xs font-mono font-semibold text-[#059669] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
              Modern Tech Stack
            </span>
          </div>

          <h3 class="text-2xl font-bold text-slate-900 mb-3">
            Fast Web Development & Landing Pages
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-6">
            Lightweight, clean web architecture engineered with Astro & Tailwind CSS. Designed specifically to capture local inquiries with crisp mobile layouts and direct WhatsApp click-to-chat triggers.
          </p>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50 border border-slate-200">
            <span class="text-slate-600 font-medium">PageSpeed Focus</span>
            <span class="text-[#059669] font-mono font-bold">Fast & Clean</span>
          </div>
          <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-50 border border-slate-200">
            <span class="text-slate-600 font-medium">Local SEO Schema</span>
            <span class="text-[#059669] font-mono font-bold">Local SEO Ready</span>
          </div>
        </div>
      </div>

      {/* Card 4: Automated B2B Lead Engine (7 Cols) */}
      <div class="lg:col-span-7 group rounded-3xl p-8 bg-white border border-slate-200/90 hover:border-emerald-400 hover:shadow-xl transition-all duration-300 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#059669]">
              <Cpu class="w-6 h-6" />
            </div>
            <span class="text-xs font-mono font-semibold text-[#059669] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
              Targeted Outreach
            </span>
          </div>

          <h3 class="text-2xl font-bold text-slate-900 mb-3">
            Automated B2B Lead Outreach & Follow-Up Pipeline
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed mb-6">
            Stop chasing leads manually. We set up targeted automation workflows that identify verified business decision-makers across Delhi NCR and India, sending personalized email and follow-up sequences so interested clients reach you directly.
          </p>
        </div>

        <div class="grid grid-cols-3 gap-3 text-center">
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="text-xl font-bold text-slate-900">Verified</div>
            <div class="text-[11px] text-slate-500 font-medium">B2B Contact Lists</div>
          </div>
          <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200">
            <div class="text-xl font-bold text-[#059669]">Multi-Touch</div>
            <div class="text-[11px] text-emerald-800 font-medium">Email & Follow-ups</div>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="text-xl font-bold text-slate-900">100%</div>
            <div class="text-[11px] text-slate-500 font-medium">Automated Workflow</div>
          </div>
        </div>
      </div>

      {/* Card 5: Knowledge Base & Document Search (12 Cols) */}
      <div class="lg:col-span-12 group rounded-3xl p-8 bg-gradient-to-r from-emerald-50/70 via-white to-slate-50 border border-slate-200/90 hover:border-emerald-400 hover:shadow-xl transition-all duration-300 shadow-xs flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 text-xs font-mono text-[#059669] font-semibold">
            <ShieldCheck class="w-4 h-4 text-[#059669]" />
            Private Data Security & Knowledge Retrieval
          </div>
          <h3 class="text-2xl font-bold text-slate-900">
            Internal Company Knowledge Base (Private AI Search)
          </h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Ingest your company SOPs, product specs, catalogs, and documentation. Your team and clients query an AI assistant that provides accurate information with strict data privacy.
          </p>
        </div>

        <div class="shrink-0">
          <a
            href="#audit-section"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-black bg-[#00dc82] hover:bg-[#05df85] transition-all shadow-md hover:shadow-[0_4px_20px_rgba(0,220,130,0.4)] cursor-pointer text-sm"
          >
            <span>Deploy Custom AI Agent</span>
            <ArrowUpRight class="w-4 h-4" />
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
