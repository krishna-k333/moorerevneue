---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import Testimonials from "../components/Testimonials.astro";
import AuditForm from "../components/AuditForm";
import FaqSection, { faqsData } from "../components/FaqSection";
import Footer from "../components/Footer.astro";

// FAQ Schema for Rich Search Snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqsData.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};
---

<Layout
  title="AI Automation and Web Development in Faridabad | MooreRevenue"
  description="AI automation agency in Faridabad building custom AI voice agents, WhatsApp bots, and fast modern websites. Book your free discovery call today!"
  canonicalUrl="https://www.moorerevenue.com"
  faqSchema={faqSchema}
>
  <!-- Fixed Navigation Header (Hydrates when browser is idle) -->
  <Navbar client:idle />

  <main>
    <!-- Hero Section: Fast & Optimized Native Astro -->
    <Hero />

    <!-- Services Grid: Core Services in Simple Manner -->
    <ServicesGrid />

    <!-- Client Testimonial Video Section -->
    <Testimonials />

    <!-- Free AI Discovery Audit Lead Capture Form -->
    <AuditForm client:visible />

    <!-- SEO Rich FAQ Section with Accordion -->
    <FaqSection client:visible />
  </main>

  <!-- Footer with Local SEO NAP Citations -->
  <Footer />
</Layout>
