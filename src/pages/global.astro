---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import AuditForm from "../components/AuditForm";
import Testimonials from "../components/Testimonials.astro";
import { BUSINESS } from "../lib/business";
import { 
  Workflow, 
  MessageSquare, 
  Laptop, 
  Layers,
  Clock, 
  CreditCard, 
  Video, 
  CheckCircle2, 
  ArrowRight,
  ShieldCheck
} from "lucide-react";

const pageUrl = `${BUSINESS.url}/global`;

const breadcrumbs = [
  { name: "Home", url: `${BUSINESS.url}/` },
  { name: "Global Clients", url: pageUrl },
];

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "AI Automations & Modern Websites for Global Clients | MooreRevenue",
  "description": "MooreRevenue builds practical workflow automations and clean modern websites for businesses worldwide. Direct communication, clear pricing, and reliable delivery.",
  "url": pageUrl,
  "publisher": { "@id": `${BUSINESS.url}/#organization` },
};


const services = [
  {
    title: "Business Workflow Automation",
    badge: "n8n, Make & APIs",
    icon: Workflow,
    desc: "Connect your CRM, forms, email, and databases. Automate routine manual tasks so your leads are organized and your team saves time every day.",
  },
  {
    title: "Chat & Messaging Automation",
    badge: "WhatsApp & Chatbots",
    icon: MessageSquare,
    desc: "Automated chat flows to answer common customer inquiries, share helpful information, and route warm leads directly to your team.",
  },
  {
    title: "Modern Web Development",
    badge: "Astro & React",
    icon: Laptop,
    desc: "Clean, responsive websites and landing pages built for your business. Fast, mobile-friendly, and easy to maintain without unnecessary clutter.",
  },
  {
    title: "API & Tool Integrations",
    badge: "Custom Integrations",
    icon: Layers,
    desc: "Connect your everyday tools, payment gateways, and databases together so information flows smoothly across your business.",
  },
];
---

<Layout
  title="AI Automations & Modern Websites for Global Clients | MooreRevenue"
  description="MooreRevenue builds practical workflow automations and clean modern websites for businesses worldwide. Direct communication, clear pricing, and reliable delivery."
  canonicalUrl={pageUrl}
  breadcrumbs={breadcrumbs}
  schemas={[webPageSchema]}
>
  <Navbar client:load />

  <main class="pt-32 pb-24 bg-white">
    {/* Hero Section */}
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
        AI Automation <span class="text-[#059669]">Agency</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        We build AI Automation systems and websites for businesses so AI does the work and you book the revenue
      </p>

      {/* Quick reassurance pill row */}
      <div class="pt-2 flex flex-wrap items-center justify-center gap-4 text-xs font-medium text-slate-600">
        <span class="inline-flex items-center gap-1.5 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs">
          <CheckCircle2 class="w-3.5 h-3.5 text-[#059669]" />
          Direct builder communication
        </span>
        <span class="inline-flex items-center gap-1.5 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs">
          <CheckCircle2 class="w-3.5 h-3.5 text-[#059669]" />
          Clear, upfront pricing
        </span>
        <span class="inline-flex items-center gap-1.5 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs">
          <CheckCircle2 class="w-3.5 h-3.5 text-[#059669]" />
          Practical, working solutions
        </span>
      </div>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a
          href="#audit-section"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#00dc82] hover:bg-[#05df85] text-black font-bold text-sm shadow-md transition-all cursor-pointer"
        >
          <span>Discuss Your Project</span>
          <ArrowRight class="w-4 h-4" />
        </a>
        <a
          href={BUSINESS.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-800 font-semibold text-sm border border-slate-200 transition-all shadow-xs"
        >
          <MessageSquare class="w-4 h-4 text-[#059669]" />
          <span>Quick WhatsApp Chat</span>
        </a>
      </div>
    </section>

    {/* What We Build */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          What We Build for Global Clients
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2">
          Practical systems that solve real operational headaches without unnecessary complexity.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map((item) => (
          <div class="p-7 rounded-2xl bg-white border border-slate-200 hover:border-emerald-300 transition-all shadow-xs space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold text-[#059669] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
                {item.badge}
              </span>
              <item.icon class="w-5 h-5 text-slate-400" />
            </div>
            <h3 class="text-xl font-bold text-slate-900">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* How Working With Us Actually Works */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
      <div class="p-8 sm:p-12 rounded-3xl bg-slate-50 border border-slate-200 shadow-xs space-y-10">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">
            How Working With Us Works
          </h2>
          <p class="text-sm text-slate-600">
            Simple, honest collaboration with clear milestones and regular updates.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-[#059669] shadow-xs">
              <Clock class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-slate-900">Time Zone Overlap</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              We schedule calls during convenient overlapping hours across North America, Europe, and Australia so meetings are easy to attend.
            </p>
          </div>

          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-[#059669] shadow-xs">
              <Video class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-slate-900">Loom & Async Updates</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Instead of endless meetings, we share short video walkthroughs and updates showing live progress.
            </p>
          </div>

          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-[#059669] shadow-xs">
              <CreditCard class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-slate-900">Straightforward Billing</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Transparent project quotes in USD, EUR, or GBP. Pay securely via Wise, Stripe, or standard bank transfer.
            </p>
          </div>

          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-[#059669] shadow-xs">
              <ShieldCheck class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-slate-900">Full Ownership</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              No lock-in. Everything is deployed directly to your accounts, and we provide clean documentation so you stay in complete control.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Testimonials Section */}
    <div class="mt-24">
      <Testimonials />
    </div>

    {/* Contact / Audit Form Section */}
    <div id="audit-section" class="mt-10">
      <AuditForm client:visible />
    </div>
  </main>

  <Footer />
</Layout>
