---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import AuditForm from "../components/AuditForm";
import { BUSINESS, telHref } from "../lib/business";
import { 
  Globe, 
  PhoneCall, 
  Workflow, 
  MessageSquare, 
  Laptop, 
  Clock, 
  CreditCard, 
  Video, 
  CheckCircle2, 
  ArrowRight,
  ShieldCheck,
  Zap
} from "lucide-react";

const pageUrl = `${BUSINESS.url}/global`;

const breadcrumbs = [
  { name: "Home", url: `${BUSINESS.url}/` },
  { name: "Global Clients", url: pageUrl },
];

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Global Remote AI Automation & Web Development | MooreRevenue",
  "description": "MooreRevenue builds practical AI voice agents, workflow automations, and fast websites for businesses worldwide. Direct communication, fair pricing, and quick turnaround.",
  "url": pageUrl,
  "publisher": { "@id": `${BUSINESS.url}/#organization` },
};

const faqs = [
  {
    q: "How do we collaborate across different time zones?",
    a: "We work on an async-first workflow. For quick updates and progress demos, we use Loom videos, Slack, or WhatsApp. When live meetings are needed, we schedule calls during overlapping working hours across US (EST/PST), UK (GMT), Europe (CET), and Australia (AEST)."
  },
  {
    q: "How do international payments work?",
    a: "We issue clear commercial invoices with payments handled via Wise, Stripe, or direct international bank wire in your preferred currency (USD, GBP, EUR, AUD, etc.)."
  },
  {
    q: "Who actually builds the systems?",
    a: "You work directly with Krishna and our focused core team. No junior account reps, no outsourcing to random contractors. You talk directly with the person building your workflows or website."
  },
  {
    q: "Who owns the code, accounts, and workflows?",
    a: "You own 100% of everything we build. All automations, Vapi/Retell setups, codebases, and integrations are deployed directly into your own accounts or handed over completely upon completion."
  },
  {
    q: "Can you connect with our existing tools and CRM?",
    a: "Yes. We frequently integrate with tools like GoHighLevel, HubSpot, Airtable, Notion, Google Workspace, Stripe, Twilio, and custom REST APIs."
  }
];

const services = [
  {
    title: "AI Voice Calling Agents",
    badge: "Vapi & Retell AI",
    icon: PhoneCall,
    desc: "Inbound phone agents that answer after-hours questions, qualify leads, and schedule appointments straight into your calendar. Outbound agents for instant follow-up when someone fills a form.",
  },
  {
    title: "Workflow Automation",
    badge: "n8n, Make & APIs",
    icon: Workflow,
    desc: "Connect your CRM, forms, email, and internal databases. Eliminate repetitive data entry, route leads instantly, and make sure customer inquiries never get lost.",
  },
  {
    title: "WhatsApp & Omnichannel Bots",
    badge: "Meta Cloud API",
    icon: MessageSquare,
    desc: "Automated customer chat pipelines that handle common queries, send order or appointment reminders, and hand off warm leads directly to your team.",
  },
  {
    title: "Fast Custom Websites",
    badge: "Astro & React",
    icon: Laptop,
    desc: "Clean, responsive websites and landing pages built for speed and conversions. No heavy plugin-bloated templates—just fast code that loads in under 1 second.",
  },
];
---

<Layout
  title="Global Remote AI Automation & Web Development | MooreRevenue"
  description="MooreRevenue builds practical AI voice agents, workflow automations, and fast websites for businesses worldwide. Direct communication, fair pricing, and quick turnaround."
  canonicalUrl={pageUrl}
  breadcrumbs={breadcrumbs}
  schemas={[webPageSchema]}
>
  <Navbar client:load />

  <main class="pt-32 pb-24 bg-white">
    {/* Hero Section */}
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-50 text-[#059669] text-xs font-semibold uppercase tracking-wider shadow-xs">
        <Globe class="w-3.5 h-3.5" />
        Worldwide • Remote Deployments
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
        AI Automations & Fast Websites for <span class="text-[#059669]">Global Clients</span>
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        We're a boutique agency based in India, building practical AI voice agents, backend automations, and high-performance websites for founders and operators across the US, UK, Australia, Canada, and Europe.
      </p>

      {/* Quick reassurance pill row */}
      <div class="pt-2 flex flex-wrap items-center justify-center gap-4 text-xs font-medium text-slate-600">
        <span class="inline-flex items-center gap-1.5 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs">
          <CheckCircle2 class="w-3.5 h-3.5 text-[#059669]" />
          Direct builder communication
        </span>
        <span class="inline-flex items-center gap-1.5 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs">
          <CheckCircle2 class="w-3.5 h-3.5 text-[#059669]" />
          No big-agency retainers
        </span>
        <span class="inline-flex items-center gap-1.5 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg shadow-xs">
          <CheckCircle2 class="w-3.5 h-3.5 text-[#059669]" />
          Delivery in 5–10 days
        </span>
      </div>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <a
          href="#audit-section"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#00dc82] hover:bg-[#05df85] text-black font-bold text-sm shadow-md transition-all cursor-pointer"
        >
          <span>Discuss Your Project</span>
          <ArrowRight class="w-4 h-4" />
        </a>
        <a
          href={BUSINESS.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-800 font-semibold text-sm border border-slate-200 transition-all shadow-xs"
        >
          <MessageSquare class="w-4 h-4 text-[#059669]" />
          <span>Quick WhatsApp Chat</span>
        </a>
      </div>
    </section>

    {/* What We Build */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          What We Build for Remote Clients
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2">
          Focused tools that solve real operational headaches, without unnecessary complexity.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map((item) => (
          <div class="p-7 rounded-2xl bg-white border border-slate-200 hover:border-emerald-300 transition-all shadow-xs space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold text-[#059669] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
                {item.badge}
              </span>
              <item.icon class="w-5 h-5 text-slate-400" />
            </div>
            <h3 class="text-xl font-bold text-slate-900">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* Why Remote Clients Work With Us */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
      <div class="p-8 sm:p-12 rounded-3xl bg-slate-50 border border-slate-200 shadow-xs space-y-10">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">
            How Working With Us Actually Works
          </h2>
          <p class="text-sm text-slate-600">
            Simple, honest collaboration with clear milestones and regular updates.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-[#059669] shadow-xs">
              <Clock class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-slate-900">Time Zone Overlap</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              We coordinate schedule slots for live calls during morning US (EST/PST) or European afternoon hours so meetings are easy to attend.
            </p>
          </div>

          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-[#059669] shadow-xs">
              <Video class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-slate-900">Loom & Async Updates</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Instead of endless meetings, we send quick 2-minute video walkthroughs showing live demos of what we built.
            </p>
          </div>

          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-[#059669] shadow-xs">
              <CreditCard class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-slate-900">Simple International Billing</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Transparent project quotes in USD, EUR, or GBP. Pay via Wise, Stripe, or standard bank wire without currency confusion.
            </p>
          </div>

          <div class="space-y-2.5">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-[#059669] shadow-xs">
              <ShieldCheck class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-slate-900">Full Ownership</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              No vendor lock-in. Everything is deployed directly to your accounts, and we provide clean documentation so you stay in full control.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Step by step process */}
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">
          Our 4-Step Engagement Process
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-2">
          <div class="text-xs font-mono font-bold text-[#059669]">Step 01</div>
          <h3 class="text-base font-bold text-slate-900">15-Min Intro or Loom</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Tell us about your current workflow, what you want to automate, or what site you want to build.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-2">
          <div class="text-xs font-mono font-bold text-[#059669]">Step 02</div>
          <h3 class="text-base font-bold text-slate-900">Scope & Fixed Quote</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            We provide a clear, 1-page scope outlining deliverables, exact timelines, and a fixed price.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-2">
          <div class="text-xs font-mono font-bold text-[#059669]">Step 03</div>
          <h3 class="text-base font-bold text-slate-900">Sprint Build (3–10 Days)</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            We build the solution and share private test links or live phone numbers for you to try out.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-2">
          <div class="text-xs font-mono font-bold text-[#059669]">Step 04</div>
          <h3 class="text-base font-bold text-slate-900">Live Handover & Support</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            We verify the setup together, record video guides for your team, and stay on hand for post-launch adjustments.
          </p>
        </div>
      </div>
    </section>

    {/* Frequently Asked Questions */}
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">
          Frequently Asked Questions
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Straight answers about working with an overseas boutique agency.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 shadow-xs space-y-2">
            <h3 class="text-base font-bold text-slate-900">{faq.q}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    {/* Contact / Audit Form Section */}
    <div class="mt-20">
      <AuditForm client:visible />
    </div>
  </main>

  <Footer />
</Layout>
