---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import { BUSINESS } from "../lib/business";
import { SITE_PAGES } from "./api/search.json";

const searchTitle = `Search MooreRevenue | AI Automation Agency`;
const searchDesc = `Search pages, services, articles, and solutions across MooreRevenue.`;
---

<Layout
  title={searchTitle}
  description={searchDesc}
  canonicalUrl="https://www.moorerevenue.com/search"
>
  <Navbar client:idle />

  <main class="min-h-[70vh] pt-36 pb-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center sm:text-left">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Search Results
        </h1>
        <p class="mt-2 text-slate-600 text-sm sm:text-base">
          Find services, guides, and resources across MooreRevenue.
        </p>
      </div>

      <!-- Search Input UI -->
      <form action="/search" method="get" class="mb-8">
        <div class="flex gap-2">
          <input
            id="search-input"
            type="search"
            name="q"
            placeholder="Search voice agents, automation, local SEO..."
            class="flex-1 px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white focus:outline-none focus:border-[#059669] focus:ring-1 focus:ring-[#059669] text-sm"
          />
          <button
            type="submit"
            class="px-6 py-3 rounded-xl bg-[#00dc82] hover:bg-[#05df85] text-black font-bold text-sm transition-all"
          >
            Search
          </button>
        </div>
      </form>

      <!-- Results Container (hydrated via client-side script) -->
      <div id="results-container" class="space-y-4">
        <p class="text-slate-500 text-sm">Enter a keyword above to search the site.</p>
      </div>
    </div>
  </main>

  <Footer />

  <script is:inline define:vars={{ initialPages: SITE_PAGES }}>
    (function () {
      const urlParams = new URLSearchParams(window.location.search);
      const query = (urlParams.get("q") || "").trim().toLowerCase();
      const input = document.getElementById("search-input");
      const container = document.getElementById("results-container");

      if (input && query) {
        input.value = query;
      }

      if (!query) {
        return;
      }

      const terms = query.split(/\s+/).filter(Boolean);
      const matched = initialPages.filter(function (page) {
        const text = ((page.title || "") + " " + (page.excerpt || "") + " " + (page.url || "")).toLowerCase();
        return terms.every(function (t) { return text.includes(t); }) || terms.some(function (t) { return text.includes(t); });
      });

      if (!container) return;

      if (matched.length === 0) {
        container.innerHTML = '<div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 text-slate-600 text-sm">No results found for "' + query.replace(/</g, "&lt;") + '". Try another keyword like voice agents, automation, or SEO.</div>';
        return;
      }

      container.innerHTML = matched.map(function (item) {
        return (
          '<div class="p-6 rounded-2xl bg-slate-50 hover:bg-slate-100/80 border border-slate-200 transition-colors">' +
            '<a href="' + item.url + '" class="text-lg font-bold text-slate-900 hover:text-[#059669] block">' +
              item.title +
            '</a>' +
            '<p class="text-sm text-slate-600 mt-1 leading-relaxed">' +
              item.excerpt +
            '</p>' +
            '<a href="' + item.url + '" class="inline-block mt-2 text-xs font-semibold text-[#059669] hover:underline">' +
              item.url + ' &rarr;' +
            '</a>' +
          '</div>'
        );
      }).join("");
    })();
  </script>
</Layout>
