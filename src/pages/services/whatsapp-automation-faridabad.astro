---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar";
import Footer from "../../components/Footer.astro";
import { 
  MessageSquare, 
  CheckCircle2, 
  ArrowRight, 
  PhoneCall, 
  Zap, 
  ShieldCheck, 
  Clock 
} from "lucide-react";

const pageFaqs = [
  {
    question: "What is WhatsApp Business automation?",
    answer: "WhatsApp automation can connect a business account with selected tools to support tasks such as responding to inquiries, collecting details, sharing product information, or routing conversations. The available workflow depends on account access, platform policies, and integrations.",
  },
  {
    question: "Is this built on the official Meta WhatsApp Cloud API?",
    answer: "We connect selected business workflows with Meta's official WhatsApp Cloud API to send approved messages, share information, and route inquiries.",
  },
  {
    question: "What information can an automated WhatsApp workflow share?",
    answer: "A workflow can share business-approved product details, catalogs, links, and other materials supplied for the setup. It can also collect inquiry details or route a conversation to your team.",
  },
  {
    question: "How does it connect to our sales team's workflow?",
    answer: "When a high-intent commercial lead is qualified or requests a site inspection, the bot automatically alerts your sales director with a full lead brief, calendar booking link, and customer contact record synced to your CRM.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": pageFaqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};

const breadcrumbs = [
  { name: "Home", url: "https://www.moorerevenue.com/" },
  { name: "Services", url: "https://www.moorerevenue.com/services" },
  { name: "WhatsApp Automation", url: "https://www.moorerevenue.com/services/whatsapp-automation-faridabad" }
];
---

<Layout
  title="WhatsApp Business Automation Services | MooreRevenue"
  description="Automate WhatsApp inquiry responses, product information sharing, follow-ups, and conversation routing with MooreRevenue."
  canonicalUrl="https://www.moorerevenue.com/services/whatsapp-automation-faridabad"
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Navbar client:load />

  <main class="pt-32 pb-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono">
        <a href="/" class="hover:text-[#059669]">Home</a>
        <span>/</span>
        <a href="/services" class="hover:text-[#059669]">Services</a>
        <span>/</span>
        <span class="text-slate-700 font-medium">WhatsApp Automation</span>
      </nav>
    </div>

    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-emerald-500/30 bg-emerald-50 text-[#059669] text-xs font-semibold uppercase tracking-wider shadow-xs">
        <MessageSquare class="w-3.5 h-3.5" />
        WhatsApp Business automation for selected workflows
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
        WhatsApp Business automation for customer conversations
      </h1>

      <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-700 shadow-xs">
        <div class="flex items-center gap-2">
          <MessageSquare class="w-4 h-4 text-[#059669]" />
          <span>Inquiry responses, product information, and follow-up workflows</span>
        </div>
        <div class="flex items-center gap-3">
          <a href="tel:+918287367640" class="text-slate-700 font-mono font-medium hover:underline">+91 8287367640</a>
          <span class="text-slate-300">•</span>
          <a href="https://wa.me/918287367640" target="_blank" rel="noopener noreferrer" class="text-[#059669] font-mono font-bold hover:underline">WhatsApp Chat</a>
        </div>
      </div>
    </section>

    <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-14 space-y-12 text-slate-600 leading-relaxed">
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          What WhatsApp automation can do
        </h2>
        <p>
          Some businesses use WhatsApp to receive customer inquiries and share product or service information. The workflow and response timing depend on your team's processes and the integrations selected.
        </p>
        <p>
          MooreRevenue can configure WhatsApp workflows to send selected information, collect inquiry details, or support appointment requests. The exact functions depend on your business requirements and available integrations.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Related services
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-xs font-mono">
          <a href="/services/ai-voice-agent-faridabad" class="p-3 rounded-xl bg-white hover:bg-emerald-50 border border-slate-200 text-slate-700 hover:text-[#059669] transition-colors shadow-xs">AI Voice Agents →</a>
          <a href="/services/ai-automation-agency-faridabad" class="p-3 rounded-xl bg-white hover:bg-emerald-50 border border-slate-200 text-slate-700 hover:text-[#059669] transition-colors shadow-xs">AI Automation Agency →</a>
          <a href="/services/website-development-faridabad" class="p-3 rounded-xl bg-white hover:bg-emerald-50 border border-slate-200 text-slate-700 hover:text-[#059669] transition-colors shadow-xs">Web Development →</a>
        </div>
      </section>

      <section class="space-y-6 pt-6 border-t border-slate-200">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Frequently Asked Questions: WhatsApp Automation
        </h2>
        <div class="space-y-4">
          {pageFaqs.map((faq) => (
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-2">
              <h3 class="text-base font-bold text-slate-900">{faq.question}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-16 p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-emerald-50/80 via-white to-slate-50 border border-emerald-300 text-center space-y-6 shadow-xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-emerald-500/30 bg-emerald-50 text-[#059669] text-xs font-semibold uppercase tracking-wider shadow-xs">
          <MessageSquare class="w-3.5 h-3.5" />
          Plan a WhatsApp workflow
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight max-w-2xl mx-auto">
          Discuss your WhatsApp automation needs
        </h2>
        <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto leading-relaxed">
          Tell us what your team handles in WhatsApp and which steps you want to automate.
        </p>
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/#audit-section"
            class="w-full sm:w-auto px-8 py-4 text-base font-bold text-black bg-[#00dc82] hover:bg-[#05df85] rounded-xl shadow-[0_4px_16px_rgba(0,220,130,0.3)] hover:shadow-[0_6px_24px_rgba(0,220,130,0.5)] transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Book Free Automation Audit</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="https://wa.me/918287367640"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-800 font-mono font-semibold text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer shadow-xs"
          >
            <MessageSquare class="w-4 h-4 text-[#059669]" />
            <span>WhatsApp +91 8287367640</span>
          </a>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</Layout>
