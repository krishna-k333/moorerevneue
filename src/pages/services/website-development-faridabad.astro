---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar";
import Footer from "../../components/Footer.astro";
import { 
  Globe, 
  CheckCircle2, 
  ArrowRight, 
  PhoneCall, 
  Zap, 
  ShieldCheck, 
  LayoutDashboard, 
  Search,
  MessageSquare 
} from "lucide-react";

const pageFaqs = [
  {
    question: "What does MooreRevenue include in website development?",
    answer: "Website projects can include page structure, responsive layouts, content setup, contact paths, search metadata, and integrations selected for your business needs.",
  },
  {
    question: "Can a website connect visitors with my business?",
    answer: "A website can give visitors clear ways to call, send a message, request information, or complete another action that fits your business.",
  },
  {
    question: "Can a website include search-friendly content and structured data?",
    answer: "We organize page content and technical details so search systems can better understand your services, business information, and the purpose of each page. Structured data can provide additional context about the content on your site.",
  },
  {
    question: "Can MooreRevenue integrate AI Voice and WhatsApp chat agents directly into our website?",
    answer: "Depending on the project scope, a website can include chat widgets, WhatsApp links, or click-to-call links. Integrations are confirmed during planning.",
  },
  {
    question: "How long does a custom website development project take?",
    answer: "The project timeline depends on the site size, content readiness, integrations, and feedback cycles. MooreRevenue will agree on a schedule after reviewing the requirements.",
  },
  {
    question: "Who owns the code and website assets upon completion?",
    answer: "Ownership, access, and handover details are agreed for each project and documented in its scope.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": pageFaqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};

const breadcrumbs = [
  { name: "Home", url: "https://www.moorerevenue.com/" },
  { name: "Services", url: "https://www.moorerevenue.com/services" },
  { name: "Website Development", url: "https://www.moorerevenue.com/services/website-development-faridabad" }
];
---

<Layout
  title="Website Design and Development Services | MooreRevenue"
  description="Plan and build a business website with clear pages, responsive layouts, useful content, and practical contact paths."
  canonicalUrl="https://www.moorerevenue.com/services/website-development-faridabad"
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Navbar client:load />

  <main class="pt-32 pb-24 bg-white">
    {/* Breadcrumbs */}
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono">
        <a href="/" class="hover:text-[#059669]">Home</a>
        <span>/</span>
        <a href="/services" class="hover:text-[#059669]">Services</a>
        <span>/</span>
        <span class="text-slate-700 font-medium">Website Development</span>
      </nav>
    </div>

    {/* Hero & Header */}
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-emerald-500/30 bg-emerald-50 text-[#059669] text-xs font-semibold uppercase tracking-wider shadow-xs">
        <Globe class="w-3.5 h-3.5" />
        Website design and development
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
        Websites Design & Development
      </h1>

      {/* Contact Bar */}
      <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-700 shadow-xs">
        <div class="flex items-center gap-2">
          <Globe class="w-4 h-4 text-[#059669]" />
          <span>Page structure, responsive design, content, and contact paths</span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/portfolio" class="text-xs font-bold text-[#059669] bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 px-3 py-1.5 rounded-lg transition-colors">
            View Our Website Portfolio →
          </a>
          <a href="tel:+918287367640" class="text-slate-700 font-mono font-medium hover:underline">+91 8287367640</a>
          <span class="text-slate-300">•</span>
          <a href="https://wa.me/918287367640" target="_blank" rel="noopener noreferrer" class="text-[#059669] font-mono font-bold hover:underline">WhatsApp Chat</a>
        </div>
      </div>
    </section>

    {/* Detailed Article */}
    <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-14 space-y-12 text-slate-600 leading-relaxed">
      
      {/* Section 1: Modern Web Engineering vs Outdated Templates */}
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          A clear website for your business
        </h2>
        <p>
          A useful business website explains what you offer, who it helps, and how a visitor can take the next step. MooreRevenue builds page layouts and content around those needs, with responsive design and the technical structure selected for the project.
        </p>
        
      </section>

      {/* Section 2: Core Web Pillars */}
      <section class="space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          What a website project can include
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <Zap class="w-5 h-5 text-[#059669]" />
              Fast Page Load Speed
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Minimal layout shifts, lean modern code, and lightweight assets so mobile visitors don't bounce. Built to provide a smooth, responsive experience for users and search engines.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <Search class="w-5 h-5 text-[#059669]" />
              Search-friendly page structure
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              We add relevant structured data to describe your business, services, and page content in a format search systems can interpret.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <LayoutDashboard class="w-5 h-5 text-[#059669]" />
              Conversion-Focused User Journey
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Clear navigation, useful page sections, and contact actions that help visitors find relevant information and get in touch.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
              <ShieldCheck class="w-5 h-5 text-[#059669]" />
              AI & WhatsApp Integration
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Websites can include links or integrations with voice and WhatsApp workflows where these fit the project. Response timing depends on the connected systems and configuration.
            </p>
          </div>
        </div>
      </section>

      {/* Section 4: Related Services */}
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Related services
        </h2>
        <p>
          Websites can work alongside other business tools and customer workflows.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-xs font-mono">
          <a href="/services/ai-voice-agent-faridabad" class="p-3 rounded-xl bg-white hover:bg-emerald-50 border border-slate-200 text-slate-700 hover:text-[#059669] transition-colors shadow-xs">AI Voice Agents →</a>
        </div>
      </section>

      {/* Section 5: FAQs */}
      <section class="space-y-6 pt-6 border-t border-slate-200">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Frequently Asked Questions About Website Development
        </h2>
        
        <div class="space-y-4">
          {pageFaqs.map((faq) => (
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-2">
              <h3 class="text-base font-bold text-slate-900">
                {faq.question}
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>

      {/* CTA Box */}
      <section class="mt-16 p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-emerald-50/80 via-white to-slate-50 border border-emerald-300 text-center space-y-6 shadow-xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-emerald-500/30 bg-emerald-50 text-[#059669] text-xs font-semibold uppercase tracking-wider shadow-xs">
          <Globe class="w-3.5 h-3.5" />
          Website review for your business
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight max-w-2xl mx-auto">
          Discuss a website for your business
        </h2>
        <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto leading-relaxed">
          Tell us what your website needs to explain or help visitors do.
        </p>
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/#audit-section"
            class="w-full sm:w-auto px-8 py-4 text-base font-bold text-black bg-[#00dc82] hover:bg-[#05df85] rounded-xl shadow-[0_4px_16px_rgba(0,220,130,0.3)] hover:shadow-[0_6px_24px_rgba(0,220,130,0.5)] transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>Book Website Discovery Audit</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="https://wa.me/918287367640"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-800 font-mono font-semibold text-sm flex items-center justify-center gap-2 transition-colors cursor-pointer shadow-xs"
          >
            <MessageSquare class="w-4 h-4 text-[#059669]" />
            <span>WhatsApp +91 8287367640</span>
          </a>
        </div>
      </section>

    </article>
  </main>

  <Footer />
</Layout>
