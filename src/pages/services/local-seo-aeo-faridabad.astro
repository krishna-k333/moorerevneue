---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar";
import Footer from "../../components/Footer.astro";
import { 
  Search, 
  Bot, 
  MapPin, 
  CheckCircle2, 
  ArrowRight, 
  PhoneCall, 
  Zap, 
  ShieldCheck, 
  BarChart3, 
  Globe, 
  Target, 
  Sparkles,
  Layers
} from "lucide-react";

const pageFaqs = [
  {
    question: "What is the difference between Local SEO and Answer Engine Optimization (AEO)?",
    answer: "Local SEO improves your local search presence through your Google Business Profile, website, and business listings. Answer Engine Optimization (AEO) structures useful information so search systems and AI tools can understand your services and business details.",
  },
  {
    question: "What work can local SEO include?",
    answer: "MooreRevenue reviews your Google Business Profile, improves relevant website pages, checks business listing consistency, and identifies local content opportunities. This work helps customers find clear, consistent information about your business in local search.",
  },
  {
    question: "How can local SEO help my business attract more local customers?",
    answer: "A clear Google Business Profile, useful local service pages, and consistent business details help nearby customers understand what you offer and how to contact you when they search for relevant services.",
  },
  {
    question: "How can AEO support AI search visibility?",
    answer: "AEO makes your service information clear, well-structured, and consistent across your website and business profiles. This helps AI search tools understand what your business does and which customers it serves.",
  },
  {
    question: "What is your weekly reporting and communication process?",
    answer: "Reporting frequency and format are agreed as part of the project scope. Updates can cover completed work, open items, and available search visibility data.",
  },
  {
    question: "Do you offer geographic territory exclusivity?",
    answer: "Any geographic or industry exclusivity would need to be discussed and clearly included in a written project agreement.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": pageFaqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Local SEO and AI Search Visibility",
  "serviceType": "Local SEO, Answer Engine Optimization, and Generative Engine Optimization",
  "provider": {
    "@type": "Organization",
    "name": "MooreRevenue",
    "url": "https://www.moorerevenue.com"
  },
  "url": "https://www.moorerevenue.com/services/local-seo-aeo-faridabad",
  "description": "Local SEO and AI search visibility work covering business profiles, website content, listings, and structured information."
};

const breadcrumbs = [
  { name: "Home", url: "https://www.moorerevenue.com/" },
  { name: "Services", url: "https://www.moorerevenue.com/services" },
  { name: "Local SEO and AI Search Visibility", url: "https://www.moorerevenue.com/services/local-seo-aeo-faridabad" }
];
---

<Layout
  title="Local SEO and AI Search Visibility Services | MooreRevenue"
  description="Improve local search visibility with Google Business Profile, website content, business listing, and structured information support."
  canonicalUrl="https://www.moorerevenue.com/services/local-seo-aeo-faridabad"
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <Navbar client:load />

  <main class="pt-32 pb-24 bg-white">
    {/* Breadcrumbs */}
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono">
        <a href="/" class="hover:text-[#059669]">Home</a>
        <span>/</span>
        <a href="/services" class="hover:text-[#059669]">Services</a>
        <span>/</span>
        <span class="text-slate-700 font-medium">Local SEO & AI Visibility (AEO)</span>
      </nav>
    </div>

    {/* Hero & Header */}
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-emerald-500/30 bg-emerald-50 text-[#059669] text-xs font-semibold uppercase tracking-wider shadow-xs">
        <Search class="w-3.5 h-3.5" />
        Local SEO and AI search visibility
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
        Local SEO and AI search visibility
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 max-w-3xl leading-relaxed">
        We improve local search visibility through Local SEO & Answer Engine Optimization (AEO) 
      </p>

      {/* Contact & Benchmark Bar */}
      <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-700 shadow-xs">
        <div class="flex items-center gap-2">
          <MapPin class="w-4 h-4 text-[#059669]" />
          <span>Google Business Profile, website content, and business listings</span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <a href="tel:+918287367640" class="text-slate-700 font-mono font-medium hover:underline">+91 8287367640</a>
        </div>
      </div>
    </section>

    {/* Detailed Article */}
    <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-14 space-y-14 text-slate-600 leading-relaxed">
      
      {/* Section 1: The Modern Search Reality */}
      

      {/* Section 2: The 4 Pillars */}
      <section class="space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[#059669]">Execution Blueprint</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            Areas MooreRevenue can review
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
          {/* Pillar 1 */}
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#059669]">
                <Target class="w-5 h-5" />
              </div>
              <h3 class="text-lg font-bold text-slate-900">Pillar 1: Google Business Profile (GBP) Precision</h3>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
              We review your Google Business Profile categories, services, contact details, and links, then recommend changes that fit your business and the platform's guidelines.
            </p>
          </div>

          {/* Pillar 2 */}
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#059669]">
                <Globe class="w-5 h-5" />
              </div>
              <h3 class="text-lg font-bold text-slate-900">Pillar 2: High-Leverage On-Page Local SEO</h3>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
              We review page titles, headings, location information, internal links, and local service content. Any page recommendations should reflect real services and locations served.
            </p>
          </div>

          {/* Pillar 3 */}
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#059669]">
                <ShieldCheck class="w-5 h-5" />
              </div>
              <h3 class="text-lg font-bold text-slate-900">Pillar 3: The 80/20 Citation Foundation</h3>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
              We can check whether your business details are consistent across relevant directories and suggest corrections where needed.
            </p>
          </div>

          {/* Pillar 4 */}
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[#059669]">
                <Bot class="w-5 h-5" />
              </div>
              <h3 class="text-lg font-bold text-slate-900">Pillar 4: Answer Engine Optimization (AEO / GEO)</h3>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
              We review page accessibility and structure, organize service information clearly, and add relevant structured data so search and AI systems can better interpret your business.
            </p>
          </div>
        </div>
      </section>

      {/* Section 3: Comparison Table */}


      {/* Section 4: Service Deliverables */}
      <section class="space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          What the service includes
        </h2>
        <p>
          MooreRevenue reviews the information customers and search systems use to understand a business and its services.
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <span class="font-bold text-slate-900 block text-sm">Business profile review</span>
            <span class="text-xs text-slate-500">Categories, services, details, and links</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <span class="font-bold text-slate-900 block text-sm">Website content review</span>
            <span class="text-xs text-slate-500">Page titles, headings, and service information</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <span class="font-bold text-slate-900 block text-sm">Business listing consistency</span>
            <span class="text-xs text-slate-500">Names, addresses, and contact details</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <span class="font-bold text-slate-900 block text-sm">Structured information</span>
            <span class="text-xs text-slate-500">Organization, service, and page details</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <span class="font-bold text-slate-900 block text-sm">Search visibility review</span>
            <span class="text-xs text-slate-500">How search systems interpret your content</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
            <span class="font-bold text-slate-900 block text-sm">AI search content structure</span>
            <span class="text-xs text-slate-500">Clear, direct service explanations</span>
          </div>
        </div>
      </section>

      {/* Section 5: FAQs */}
      <section class="space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Frequently Asked Questions About Local SEO & AEO
        </h2>
        <div class="space-y-4">
          {pageFaqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-2">
              <h3 class="text-base sm:text-lg font-bold text-slate-900">
                {faq.question}
              </h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>

      {/* Section 6: CTA Block */}
      <section class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white relative overflow-hidden shadow-xl text-center space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider">
          <Sparkles class="w-3.5 h-3.5" />
          Discuss your local search setup
        </div>

        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight max-w-2xl mx-auto leading-tight">
          Want to review your local search presence?
        </h2>

        <p class="text-slate-300 max-w-xl mx-auto text-sm sm:text-base leading-relaxed">
          Contact MooreRevenue to discuss your business, current online presence, and possible next steps.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
          <a
            href="https://wa.me/918287367640?text=Hi%20Krishna,%20I'd%20like%20a%20free%20Google%20Maps%20%26%20AI%20ranking%20audit%20for%20my%20business."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-[#059669] hover:bg-[#047857] text-white font-bold text-sm shadow-md hover:shadow-lg transition-all"
          >
            Contact MooreRevenue on WhatsApp
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="tel:+918287367640"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm border border-slate-700 transition-colors"
          >
            <PhoneCall class="w-4 h-4" />
            Call +91 8287367640
          </a>
        </div>
      </section>

    </article>
  </main>

  <Footer />
</Layout>
