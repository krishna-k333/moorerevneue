---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar";
import Footer from "../../components/Footer.astro";
import { 
  Volume2, 
  Layers,
  Clock, 
  Calendar, 
  ArrowRight, 
  PhoneCall,
  Sparkles
} from "lucide-react";

const pageTitle = "Blog & Practical AI Guides | MooreRevenue";
const pageDescription = "Practical guides, tutorials, and playbooks on n8n workflow automation, AI voice agents, WhatsApp pipelines, and modern tech for business owners.";
const canonicalUrl = "https://www.moorerevenue.com/blog";

const breadcrumbs = [
  { name: "Home", url: "https://www.moorerevenue.com/" },
  { name: "Blog", url: canonicalUrl }
];

const articles = [
  {
    title: "What Is n8n? A Practical Beginner’s Guide to Workflow Automation, Self‑Hosting, and Why It Still Matters in 2026",
    slug: "what-is-n8n",
    excerpt: "Discover what n8n is and how to use it in 2026. Explore fair-code workflow automation, 400+ native integrations, free Docker self-hosting, and AI agent nodes with our step-by-step video tutorial series.",
    category: "Workflow & AI Automation",
    icon: Layers,
    readTime: "6 min read",
    publishDate: "Sept 26, 2026",
    featured: true
  },
  {
    title: "What Is TTS Used For? Practical Applications for Businesses and Beyond",
    slug: "what-is-tts-used-for",
    excerpt: "Explore what text-to-speech (TTS) is used for in 2026. From AI voice agents that answer customer calls 24/7 to automated video voiceovers and accessibility tools.",
    category: "AI & Voice Technology",
    icon: Volume2,
    readTime: "5 min read",
    publishDate: "Sept 26, 2026",
    featured: false
  }
];

const featuredArticle = articles.find(a => a.featured) || articles[0];
const otherArticles = articles.filter(a => a.slug !== featuredArticle.slug);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <Navbar client:idle />

  <main class="pt-32 pb-24 bg-white text-slate-800">
    
    {/* Breadcrumbs */}
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-mono">
        <a href="/" class="hover:text-[#059669] transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-800 font-medium">Blog</span>
      </nav>
    </div>

    {/* Page Title */}
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 pb-4 border-b border-slate-200">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Blog & Automation Guides
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-2">
        Actionable playbooks, tutorials, and architecture breakdowns for business automation and AI systems.
      </p>
    </div>

    {/* Articles Container */}
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      {/* Featured Article Card */}
      {featuredArticle && (() => {
        const IconComponent = featuredArticle.icon;
        return (
          <div class="group relative rounded-3xl bg-gradient-to-br from-slate-50 via-white to-emerald-50/40 border border-slate-200 p-6 sm:p-10 shadow-lg hover:shadow-xl hover:border-emerald-500/40 transition-all duration-300">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
              
              <div class="space-y-4 max-w-3xl">
                <div class="flex items-center gap-3">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold font-mono bg-emerald-100/80 text-[#047857]">
                    <IconComponent class="w-3.5 h-3.5 text-[#00dc82]" />
                    {featuredArticle.category}
                  </span>
                  <span class="text-xs font-mono text-slate-400 flex items-center gap-1">
                    <Sparkles class="w-3 h-3 text-[#00dc82]" />
                    Featured Guide
                  </span>
                </div>

                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 group-hover:text-[#047857] transition-colors leading-tight">
                  <a href={`/blog/${featuredArticle.slug}`}>
                    {featuredArticle.title}
                  </a>
                </h2>

                <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
                  {featuredArticle.excerpt}
                </p>

                <div class="flex items-center gap-4 text-xs font-mono text-slate-500 pt-2 flex-wrap">
                  <span class="flex items-center gap-1">
                    <Calendar class="w-3.5 h-3.5" />
                    {featuredArticle.publishDate}
                  </span>
                  <span>•</span>
                  <span class="flex items-center gap-1">
                    <Clock class="w-3.5 h-3.5" />
                    {featuredArticle.readTime}
                  </span>
                  <span>•</span>
                  <span class="text-slate-700 font-semibold">By Krishna Aggarwal</span>
                </div>
              </div>

              <div class="shrink-0">
                <a
                  href={`/blog/${featuredArticle.slug}`}
                  class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-slate-900 group-hover:bg-[#00dc82] text-white group-hover:text-black font-bold text-xs sm:text-sm shadow-md transition-all duration-200"
                >
                  <span>Read Full Article</span>
                  <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                </a>
              </div>

            </div>
          </div>
        );
      })()}

      {/* More Articles Grid */}
      {otherArticles.length > 0 && (
        <div class="space-y-6 pt-4">
          <h2 class="text-xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
            <span>More Articles</span>
            <span class="text-xs font-mono font-normal text-slate-500">({otherArticles.length})</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {otherArticles.map((article) => {
              const IconComponent = article.icon;
              return (
                <div class="group relative rounded-2xl bg-white border border-slate-200 p-6 sm:p-7 shadow-xs hover:shadow-md hover:border-emerald-500/40 transition-all duration-300 flex flex-col justify-between">
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold font-mono bg-emerald-50 text-[#047857] border border-emerald-100">
                        <IconComponent class="w-3 h-3 text-[#00dc82]" />
                        {article.category}
                      </span>
                      <span class="text-xs font-mono text-slate-400">
                        {article.readTime}
                      </span>
                    </div>

                    <h3 class="text-lg font-bold text-slate-900 group-hover:text-[#047857] transition-colors leading-snug">
                      <a href={`/blog/${article.slug}`}>
                        {article.title}
                      </a>
                    </h3>

                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3">
                      {article.excerpt}
                    </p>
                  </div>

                  <div class="pt-6 flex items-center justify-between border-t border-slate-100 mt-4 text-xs font-mono text-slate-500">
                    <span class="flex items-center gap-1">
                      <Calendar class="w-3 h-3" />
                      {article.publishDate}
                    </span>
                    <a
                      href={`/blog/${article.slug}`}
                      class="inline-flex items-center gap-1 text-[#047857] font-bold group-hover:translate-x-0.5 transition-transform"
                    >
                      <span>Read Article</span>
                      <ArrowRight class="w-3.5 h-3.5" />
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* Free Audit & Consultation Card */}
      <div class="p-8 sm:p-10 rounded-3xl bg-slate-950 text-white relative overflow-hidden shadow-2xl flex flex-col md:flex-row items-center justify-between gap-8 mt-16">
        <div class="absolute -right-20 -top-20 w-72 h-72 bg-[#00dc82]/15 rounded-full blur-3xl pointer-events-none" />
        
        <div class="relative z-10 space-y-2 max-w-xl text-center md:text-left">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#00dc82]">
            Custom Business Solutions
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white leading-tight">
            Have questions about applying AI to your business?
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Book a free 30-minute discovery consultation with Krishna to discuss n8n workflow pipelines, AI voice calling, WhatsApp automations, or custom web development.
          </p>
        </div>

        <div class="relative z-10 shrink-0 flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
          <a
            href="/#audit-section"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#00dc82] hover:bg-[#05df85] text-black font-bold text-xs sm:text-sm shadow-md transition-all cursor-pointer"
          >
            <PhoneCall class="w-4 h-4" />
            <span>Book Free AI Audit</span>
          </a>
          <a
            href="https://wa.me/918287367640"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl border border-white/20 bg-white/5 hover:bg-white/10 text-white font-semibold text-xs sm:text-sm transition-colors"
          >
            <span>WhatsApp Us</span>
          </a>
        </div>
      </div>

    </section>

  </main>

  <Footer />
</Layout>
