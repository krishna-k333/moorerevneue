---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import { 
  Globe, 
  ArrowRight, 
  ExternalLink, 
  Sparkles, 
  CheckCircle2, 
  ShoppingBag, 
  BookOpen, 
  Compass, 
  Smartphone, 
  Zap, 
  MessageSquare, 
  Phone,
  ShieldCheck,
  Heart
} from "lucide-react";

const projects = [
  {
    id: "sks",
    category: "ecommerce",
    categoryLabel: "Retail & E-Commerce",
    title: "Shri Krishna Sarees",
    domain: "sksshopping.com",
    liveUrl: "https://sksshopping.com",
    screenshot: "/images/portfolio/sks.png",
    accentColor: "from-amber-600/15 via-rose-500/10 to-transparent",
    badgeColor: "bg-amber-100 text-amber-900 border-amber-200",
    summary: "Bringing a beloved 30-year Ballabgarh saree heritage store into modern e-commerce.",
    story: "Shri Krishna Sarees has been dressing families in Ballabgarh and Faridabad for weddings and festivals since 1993. They wanted a warm, elegant online store so customers could browse their authentic silk and designer collections from anywhere—without losing the personal touch of talking directly with the shop owners.",
    whatWeBuilt: [
      "Lightweight, fast online catalog with smooth fabric & occasion filters",
      "Instant 1-click WhatsApp shopping button for direct customer questions",
      "Mobile-first design that opens fast even on everyday mobile data",
      "Ballabgarh store heritage story, authentic reviews, and store visit map"
    ],
    features: [
      { label: "Mobile-First", desc: "Smooth on every phone" },
      { label: "Zero Lag", desc: "Loads instantly" },
    ],
    testimonialSnippet: "Our regular customers in Delhi NCR love browsing the collections on their phones before visiting our shop."
  },
  {
    id: "storynight",
    category: "webapp",
    categoryLabel: "Custom Web App",
    title: "Story Night 4 Kids",
    domain: "storynight4kids.shop",
    liveUrl: "https://storynight4kids.shop",
    screenshot: "/images/portfolio/storynight4kids.png",
    accentColor: "from-sky-500/15 via-indigo-500/10 to-transparent",
    badgeColor: "bg-sky-100 text-sky-900 border-sky-200",
    summary: "A joyful web app where parents turn a photo into a personalized bedtime storybook.",
    story: "Every child loves seeing themselves as the hero. Story Night 4 Kids needed an easy, delightful way for parents to pick an adventure (like Moon Rockets or Magic Gardens), upload one photo, type their child’s name, preview the pages, and download a high-res printable PDF ready for bedtime.",
    whatWeBuilt: [
      "Friendly 3-step creation flow that parents can finish in under 2 minutes",
      "Live illustrated storybook previewer with book-turning feel",
      "Secure photo upload and automated print-ready PDF generation",
      "Transparent pricing, helpful FAQs, and friendly support"
    ],
    features: [
      { label: "Custom Development", desc: "Tailored interactive app" },
      { label: "Polished UI", desc: "Playful, clean design" },
    ],
    testimonialSnippet: "Parents tell us the preview experience makes them smile the moment their child’s name appears on the book cover."
  },
  {
    id: "stoic",
    category: "experience",
    categoryLabel: "Interactive Experience",
    title: "Stoic Origo",
    domain: "stoic-vert.vercel.app",
    liveUrl: "https://stoic-vert.vercel.app/",
    screenshot: "/images/portfolio/stoic.png",
    accentColor: "from-stone-500/20 via-amber-900/15 to-transparent",
    badgeColor: "bg-stone-200 text-stone-900 border-stone-300",
    summary: "An immersive, cinematic web journey exploring ancient Stoic journals and timeless wisdom.",
    story: "Ancient philosophy can sometimes feel dry or distant. Stoic Origo was created to make reading Marcus Aurelius and Seneca feel like opening a quiet, sacred antique journal. We focused on pure atmosphere: silky smooth scrolling, deep warm lighting, and a calm, distraction-free environment.",
    whatWeBuilt: [
      "Buttery smooth custom scroll interactions that feel natural on mouse & trackpad",
      "Rich dark-mode editorial aesthetics with glowing golden typography",
      "Section-by-section room navigation highlighting key philosophical teachings",
      "Fast, lightweight performance with zero bloated libraries"
    ],
    features: [
      { label: "Smooth Motion", desc: "Silky scroll storytelling" },
    ],
    testimonialSnippet: "Designed as a digital breath of fresh air in an otherwise noisy internet world."
  }
];

const breadcrumbs = [
  { name: "Home", url: "https://moorerevenue.com/" },
  { name: "Portfolio", url: "https://moorerevenue.com/portfolio" },
];
---

<Layout
  title="Our Website Portfolio - Real Websites Built For Real Businesses | MooreRevenue"
  description="Explore real websites built by MooreRevenue. Fast, friendly, and practical websites for e-commerce, custom web apps, and local businesses."
  canonicalUrl="https://moorerevenue.com/portfolio"
  breadcrumbs={breadcrumbs}
>
  <Navbar client:load />

  <main class="pt-24 pb-20 overflow-hidden">
    <!-- Top Breadcrumbs -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-2">
      <nav aria-label="Breadcrumb" class="text-xs text-slate-500 flex items-center gap-1.5">
        <a href="/" class="hover:text-[#059669] transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-800 font-semibold">Portfolio</span>
      </nav>
    </div>

    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-[#059669] text-xs font-semibold">
          <Sparkles class="w-3.5 h-3.5" />
          <span>Real Work • Real People • Real Results</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-[1.15]">
          Websites that feel great to visit, and even better to run.
        </h1>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          We don’t believe in stiff corporate speak, overpriced templates, or confusing tech jargon. Here are a few real websites we’ve built—each one crafted by hand to be fast, friendly to your customers, and easy to run.
        </p>

        <!-- Quick Value Highlights -->
        <div class="pt-2 grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs font-medium text-slate-700">
            <Zap class="w-4 h-4 text-emerald-600 shrink-0" />
            <span>Loads in under a second</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs font-medium text-slate-700">
            <Smartphone class="w-4 h-4 text-emerald-600 shrink-0" />
            <span>Smooth on every phone</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs font-medium text-slate-700">
            <ShieldCheck class="w-4 h-4 text-emerald-600 shrink-0" />
            <span>100% Code Ownership</span>
          </div>
        </div>
      </div>

      <!-- Filter Controls -->
      <div class="mt-12 flex flex-wrap items-center gap-2 border-b border-slate-200 pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-400 mr-2">Filter:</span>
        <button
          class="filter-btn active px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-slate-900 text-white shadow-xs"
          data-filter="all"
        >
          All Projects ({projects.length})
        </button>
        <button
          class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-slate-100 text-slate-700 hover:bg-slate-200"
          data-filter="ecommerce"
        >
          E-Commerce & Shops
        </button>
        <button
          class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-slate-100 text-slate-700 hover:bg-slate-200"
          data-filter="webapp"
        >
          Custom Web Apps
        </button>
        <button
          class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer bg-slate-100 text-slate-700 hover:bg-slate-200"
          data-filter="experience"
        >
          Creative Experiences
        </button>
      </div>
    </section>

    <!-- Projects Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      {projects.map((project, idx) => (
        <article 
          class="project-card group relative rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 lg:p-10 shadow-sm hover:shadow-xl transition-all duration-300"
          data-category={project.category}
        >
          {/* Subtle Background Glow */}
          <div class={`absolute inset-0 bg-gradient-to-br ${project.accentColor} rounded-3xl opacity-60 pointer-events-none`} />

          <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            {/* Left Column: Browser Mockup Frame */}
            <div class="lg:col-span-7 order-2 lg:order-1">
              <div class="rounded-2xl border border-slate-200/90 bg-slate-900 shadow-2xl overflow-hidden transition-transform duration-300 group-hover:-translate-y-1">
                
                {/* Browser Mockup Chrome Bar */}
                <div class="bg-slate-800/90 px-4 py-3 flex items-center justify-between border-b border-slate-700/60 text-slate-400 text-xs">
                  <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                    <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                    <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                  </div>

                  {/* URL Address Bar with Site Favicon */}
                  <div class="flex items-center gap-2 px-3 py-1 rounded-lg bg-slate-900/90 border border-slate-700/50 text-[11px] font-mono text-slate-300 max-w-[280px] truncate">
                    <img
                      src={`https://www.google.com/s2/favicons?domain=${project.domain}&sz=32`}
                      alt=""
                      class="w-3.5 h-3.5 rounded-xs shrink-0"
                      loading="lazy"
                    />
                    <span class="truncate">https://{project.domain}</span>
                  </div>

                  {/* External Open Icon */}
                  <a 
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="p-1 rounded hover:text-white transition-colors"
                    title={`Open ${project.domain} in a new tab`}
                  >
                    <ExternalLink class="w-3.5 h-3.5" />
                  </a>
                </div>

                {/* Website Screenshot */}
                <div class="relative aspect-[16/10] overflow-hidden bg-slate-950">
                  <img
                    src={project.screenshot}
                    alt={`Screenshot of ${project.title} (${project.domain})`}
                    loading="lazy"
                    class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                  <div class="absolute inset-0 ring-1 ring-inset ring-black/10 pointer-events-none"></div>
                </div>

                {/* Card Footer Bar inside Frame */}
                <div class="bg-slate-900 px-4 py-2.5 flex items-center justify-between text-xs text-slate-400 border-t border-slate-800">
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-slate-300 font-medium">Live Website</span>
                  </span>
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-emerald-400 hover:text-emerald-300 font-medium inline-flex items-center gap-1 transition-colors"
                  >
                    <span>View Live Site</span>
                    <ExternalLink class="w-3 h-3" />
                  </a>
                </div>

              </div>
            </div>

            {/* Right Column: Project Story & Details */}
            <div class="lg:col-span-5 order-1 lg:order-2 space-y-5">
              
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class={`px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider border ${project.badgeColor}`}>
                    {project.categoryLabel}
                  </span>
                  <span class="text-xs text-slate-400 font-mono">
                    #{String(idx + 1).padStart(2, '0')}
                  </span>
                </div>

                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                  {project.title}
                </h2>
                
                <p class="text-sm font-medium text-[#059669]">
                  {project.summary}
                </p>
              </div>

              {/* Story paragraph in friendly language */}
              <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs sm:text-sm text-slate-600 leading-relaxed">
                <p class="font-medium text-slate-800 mb-1">The Goal & Story:</p>
                <p>{project.story}</p>
              </div>

              {/* What We Built List */}
              <div class="space-y-2">
                <p class="text-xs font-bold text-slate-900 uppercase tracking-wider font-mono">
                  What we built:
                </p>
                <ul class="space-y-2 text-xs sm:text-sm text-slate-700">
                  {project.whatWeBuilt.map((item) => (
                    <li class="flex items-start gap-2">
                      <CheckCircle2 class="w-4 h-4 text-[#059669] shrink-0 mt-0.5" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {/* Feature Chips */}
              <div class="flex flex-wrap gap-2 pt-1">
                {project.features.map((feat) => (
                  <div class="flex-1 min-w-[140px] p-2.5 rounded-xl border border-slate-200 bg-white/80">
                    <p class="text-[11px] font-bold text-slate-900">{feat.label}</p>
                    <p class="text-[11px] text-slate-500">{feat.desc}</p>
                  </div>
                ))}
              </div>

              {/* CTAs */}
              <div class="pt-3 flex flex-wrap items-center gap-3">
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs sm:text-sm transition-all shadow-md active:scale-95 cursor-pointer"
                >
                  <span>Visit {project.title}</span>
                  <ExternalLink class="w-4 h-4" />
                </a>

                <a
                  href={`https://wa.me/918287367640?text=${encodeURIComponent(`Hi Krishna, I saw your portfolio project for ${project.title} and would like to discuss a website for my business.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs sm:text-sm transition-colors"
                >
                  <MessageSquare class="w-4 h-4 text-[#059669]" />
                  <span>Ask About Similar Build</span>
                </a>
              </div>

            </div>

          </div>
        </article>
      ))}
    </section>

    <!-- Why Work With Us Section (Friendly & Approachable) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-24">
      <div class="rounded-3xl bg-slate-900 text-white p-8 sm:p-12 lg:p-16 relative overflow-hidden">
        
        {/* Background Accent Gradients */}
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#00dc82]/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#059669]/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative max-w-3xl space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-[#00dc82] text-xs font-semibold">
            <Heart class="w-3.5 h-3.5" />
            <span>Straightforward & Transparent</span>
          </div>

          <h2 class="text-2xl sm:text-4xl font-black tracking-tight leading-tight">
            How we make building a website simple and stress-free.
          </h2>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Most web agencies hand you a 40-page questionnaire, disappear for three months, and hand back a slow template you can barely edit. We do things simply:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4">
            <div class="space-y-2 p-4 rounded-2xl bg-white/5 border border-white/10">
              <span class="text-xl font-mono font-bold text-[#00dc82]">01</span>
              <h3 class="font-bold text-sm">We Listen First</h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                A simple 15-minute chat about your business, who your customers are, and what you want your website to achieve.
              </p>
            </div>

            <div class="space-y-2 p-4 rounded-2xl bg-white/5 border border-white/10">
              <span class="text-xl font-mono font-bold text-[#00dc82]">02</span>
              <h3 class="font-bold text-sm">Ready Within 7 Days</h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                We design, write clean copy, optimize for mobile, and deliver a working version you can actually click through and test within 7 days.
              </p>
            </div>

            <div class="space-y-2 p-4 rounded-2xl bg-white/5 border border-white/10">
              <span class="text-xl font-mono font-bold text-[#00dc82]">03</span>
              <h3 class="font-bold text-sm">You Own Everything</h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                100% code ownership, your domain, your hosting. No monthly hostage fees and no locking you in.
              </p>
            </div>
          </div>

          <!-- Bottom CTA -->
          <div class="pt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="https://wa.me/918287367640?text=Hi%20Krishna%2C%20I&#x27;d%20like%20to%20chat%20about%20building%20a%20website%20for%20my%20business."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#00dc82] hover:bg-[#05df85] text-black font-bold text-sm transition-all shadow-[0_4px_16px_rgba(0,220,130,0.3)] hover:shadow-[0_6px_24px_rgba(0,220,130,0.5)] cursor-pointer active:scale-95"
            >
              <MessageSquare class="w-4 h-4 text-black" />
              <span>Let's Have A Friendly Chat</span>
              <ArrowRight class="w-4 h-4 text-black" />
            </a>

            <a
              href="/#audit-section"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-white/20 bg-white/5 hover:bg-white/10 text-white font-semibold text-sm transition-colors"
            >
              <span>Book A Free 15-Min Call</span>
            </a>
          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer />

  {/* Client-side quick filter script */}
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const filterButtons = document.querySelectorAll(".filter-btn");
      const projectCards = document.querySelectorAll(".project-card");

      filterButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const filter = btn.getAttribute("data-filter");

          // Toggle button styles
          filterButtons.forEach((b) => {
            b.classList.remove("active", "bg-slate-900", "text-white");
            b.classList.add("bg-slate-100", "text-slate-700");
          });
          btn.classList.add("active", "bg-slate-900", "text-white");
          btn.classList.remove("bg-slate-100", "text-slate-700");

          // Filter cards
          projectCards.forEach((card) => {
            const cardCategory = card.getAttribute("data-category");
            if (filter === "all" || cardCategory === filter) {
              card.style.display = "block";
            } else {
              card.style.display = "none";
            }
          });
        });
      });
    });
  </script>
</Layout>
