---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  faqSchema?: object;
}

const {
  title = "AI Automation, Voice Agents & Web Development | MooreRevenue",
  description = "MooreRevenue offers AI voice agents, workflow automation, WhatsApp business automation, website development, and local SEO services.",
  canonicalUrl = "https://www.moorerevenue.com",
  image = "/og-image.png",
  breadcrumbs = [],
  faqSchema,
} = Astro.props;

const absoluteImageUrl = image.startsWith("http")
  ? image
  : `https://www.moorerevenue.com${image.startsWith("/") ? "" : "/"}${image}`;

const jsonLdLocalBusiness = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService"],
  "@id": "https://www.moorerevenue.com/#organization",
  "name": "MooreRevenue - AI Automation & Voice Agent Agency",
  "alternateName": ["MooreRevenue", "Moore Revenue Faridabad"],
  "url": "https://www.moorerevenue.com",
  "logo": "https://www.moorerevenue.com/favicon.svg",
  "image": "https://www.moorerevenue.com/og-image.png",
  "description": "MooreRevenue provides AI voice agents, workflow automation, WhatsApp business automation, website development, and local SEO services.",
  "sameAs": [
    "https://youtube.com/@preparemytech",
    "https://instagram.com/aiwkrishna"
  ],
  "founder": {
    "@type": "Person",
    "name": "Krishna Aggarwal",
    "jobTitle": "Founder",
    "telephone": "+91-8287367640",
    "url": "https://www.moorerevenue.com"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Mathura Road",
    "addressLocality": "Faridabad",
    "addressRegion": "Haryana",
    "postalCode": "121003",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 28.4089,
    "longitude": 77.3178
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Faridabad" },
    { "@type": "AdministrativeArea", "name": "Mathura Road Industrial Area" },
    { "@type": "AdministrativeArea", "name": "DLF Industrial Area Sector 24/25" },
    { "@type": "AdministrativeArea", "name": "Ballabgarh" },
    { "@type": "AdministrativeArea", "name": "Greater Faridabad" },
    { "@type": "AdministrativeArea", "name": "Sector 15 & 16 Faridabad" },
    { "@type": "AdministrativeArea", "name": "NIT Faridabad" },
    { "@type": "AdministrativeArea", "name": "Delhi NCR" },
    { "@type": "Country", "name": "India" }
  ],
  "priceRange": "$$",
  "telephone": "+91-8287367640",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"
      ],
      "opens": "09:00",
      "closes": "20:00"
    }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "AI Automation, Voice Agents & Web Development",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "AI Voice Calling & Reception Agents",
          "description": "Bilingual Hindi & English conversational AI agents for automated inbound support, appointment scheduling, and outbound lead qualification."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "AI Workflow Automation",
          "description": "End-to-end workflow automation, CRM synchronization, lead routing pipelines, and WhatsApp Cloud API bots for businesses."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Website Development",
          "description": "Modern websites and web applications built with Astro, React, and Tailwind CSS, with attention to usability, performance, and search fundamentals."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "WhatsApp CRM & Lead Pipeline Automation",
          "description": "Configured lead follow-up, catalog information, and messaging workflows across selected channels."
        }
      }
    ]
  }
};

const breadcrumbsSchema = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": crumb.name,
    "item": crumb.url
  }))
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="AI automation, AI voice agents, WhatsApp automation, website development, workflow automation, local SEO services, MooreRevenue"
    />
    <meta name="author" content="Krishna Aggarwal - MooreRevenue" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="MooreRevenue" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono (Non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- LocalBusiness & Service Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdLocalBusiness)} />
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
    {breadcrumbsSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />
    )}
  </head>
  <body class="min-h-screen bg-[#ffffff] text-slate-900 antialiased selection:bg-[#00dc82] selection:text-black overflow-x-hidden">
    <slot />
  </body>
</html>
